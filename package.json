{
  "name": "goship-express",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.25",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "essai": "node essais/essai-logique.mjs",
    "construire:essai": "EXPO_PUBLIC_GOSHIP_ENV=essai EXPO_PUBLIC_SUPABASE_URL=${GOSHIP_URL_ESSAI:-http://localhost:54321} expo export --clear --platform web --output-dir dist-essai && node essais/controle-paquet.mjs dist-essai essai",
    "essai:web": "npm run construire:essai && node essais/essai-web.mjs",
    "controle:production": "EXPO_PUBLIC_GOSHIP_ENV=production expo export --clear --platform android --platform ios --output-dir dist && node essais/controle-paquet.mjs dist production"
  },
  "private": true,
  "devDependencies": {
    "playwright-core": "1.63.0"
  }
}
