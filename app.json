{
  "expo": {
    "name": "GoShip Express",
    "slug": "goship-express",
    "scheme": "goshipexpress",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "primaryColor": "#f4600d",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goshipexpress.app",
      "infoPlist": {
        "CFBundleDisplayName": "GoShip Express",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.goshipexpress.app",
      "adaptiveIcon": {
        "backgroundColor": "#061a3f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 230,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "L'appareil photo sert à scanner le code-barres de vos colis.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#f4600d",
          "defaultChannel": "colis"
        }
      ]
    ],
    "extra": {
      "router": {}
    },
    "locales": {
      "fr": "./langues/fr.json",
      "en": "./langues/en.json",
      "es": "./langues/es.json"
    }
  }
}
